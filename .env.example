# Application
APP_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logistics
DB_SCHEMA=public

# SAP S/4HANA Connection
SAP_HOST=sap-dev.company.com
SAP_CLIENT=100
SAP_USER=rfc_user
SAP_PASSWORD=changeme
SAP_SYSTEM_NUMBER=00

# SAP EWM
EWM_HOST=ewm-dev.company.com
EWM_WAREHOUSE=WH01

# TMS API
TMS_BASE_URL=https://tms-api.company.com/v2
TMS_API_KEY=your-api-key-here

# ETL Schedule
ETL_REFRESH_MINUTES=15

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
